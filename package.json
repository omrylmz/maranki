{
  "name": "maranki",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@expo/ui": "~56.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.24",
    "expo-asset": "~56.0.25",
    "expo-constants": "~56.0.17",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-linking": "~56.0.19",
    "expo-notifications": "~56.0.26",
    "expo-router": "~56.2.22",
    "expo-sharing": "~56.0.27",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.16",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:german": "APP_VARIANT=german expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "if grep -qs \"applicationId 'com.omrylmz.maranki'\" android/app/build.gradle; then APP_VARIANT=generic expo prebuild -p android --no-install; else APP_VARIANT=generic EXPO_NO_GIT_STATUS=1 expo prebuild -p android --clean --no-install; fi && APP_VARIANT=generic expo run:android",
    "android:german": "if grep -qs \"applicationId 'com.omrylmz.marankide'\" android/app/build.gradle; then APP_VARIANT=german expo prebuild -p android --no-install; else APP_VARIANT=german EXPO_NO_GIT_STATUS=1 expo prebuild -p android --clean --no-install; fi && APP_VARIANT=german expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/check-no-deck-files.sh && tsc --noEmit && expo lint && jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@variant/pack$": "<rootDir>/src/variants/generic/pack.ts"
    }
  },
  "private": true
}
